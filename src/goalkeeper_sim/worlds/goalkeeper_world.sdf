<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="goalkeeper_world">

    <!-- Physics settings -->
    <physics name="default_physics" type="ode"> 
        <!-- Use ode physics engine -->
        <max_step_size>0.001</max_step_size>
        <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Main light source -->
    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>

        <!-- place the light source -->
        <pose>0 0 10 0 0 0</pose>

        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 0.1 -0.9</direction>

    </light>

    <model name="soccer_field">
        <static>true</static>

        <link name="field_link">

            <collision name="field_collision">
                <geometry>
                    <box>
                        <!-- size of the court -->
                        <size>20 50 0.1</size>
                    </box>
                </geometry>
            </collision>

            <visual name="field_visual">
                <geometry>
                    <box>
                        <size>20 50 0.1</size>
                    </box>
                </geometry>

                <material>
                    <!-- RGB alpha -->
                    <ambient>0.05 0.45 0.05 1</ambient>
                    <diffuse>0.05 0.45 0.05 1</diffuse>
                </material>
            </visual>

            <pose>0 0 -0.05 0 0 0</pose>
        </link>
    </model>

    <model name="goal">
        <static>true</static>
        <pose>10 0 0 0 0 0</pose>

        <link name="left_post">
            <pose>0 3.66 1.22 0 0 0</pose>

            <collision name="left_post_collision">
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>2.44</length>
                    </cylinder>
                </geometry>
            </collision>

            <visual name="left_post_visual">
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>2.44</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="right_post">
            <pose>0 -3.66 1.22 0 0 0</pose>
            
            <collision name="right_post_collision">
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>2.44</length>
                    </cylinder>
                </geometry>
            </collision>

            <visual name="right_post_visual">
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>2.44</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="crossbar">
            <!-- rotate 90° -->
            <pose>0 0 2.44 1.5708 0 0</pose>
            <collision name="crossbar_collision">
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>7.32</length>
                    </cylinder>
                </geometry>
            </collision>

            <visual name="crossbar_visual">                
                <geometry>
                    <cylinder>
                        <radius>0.06</radius>
                        <length>7.32</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                </material>
            </visual>
        </link>
    </model>

    <model name="field_marking">
        <static>true</static>

        <link name="markings_link">

            <visual name="penalty_area_front">
                <geometry>
                    <box>
                        <size>0.1 40.32 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>-6.5 0 0.006 0 0 0</pose>
            </visual>
            
            <visual name="penalty_area_left">
                <geometry>
                    <box>
                        <size>16.5 0.1 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>1.75 20.16 0.006 0 0 0</pose>
            </visual>

            <visual name="penalty_area_right">
                <geometry>
                    <box>
                        <size>16.5 0.1 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>1.75 -20.16 0.006 0 0 0</pose>
            </visual>

            <visual name="goal_area_front">
                <geometry>
                    <box>
                        <size>0.1 18.32 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>4.5 0 0.006 0 0 0</pose>
            </visual>

            <visual name="goal_area_left">
                <geometry>
                    <box>
                        <size>5.5 0.1 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>7.25 9.16 0.006 0 0 0</pose>
            </visual>

            <visual name="goal_area_right">
                <geometry>
                    <box>
                        <size>5.5 0.1 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>7.25 -9.16 0.006 0 0 0</pose>
            </visual>

            <visual name="penalty_spot">
                <geometry>
                    <cylinder>
                        <radius>0.12</radius>
                        <length>0.01</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
                <pose>-1 0 0.006 0 0 0</pose>
            </visual>
        </link>
    </model>

  </world>

</sdf>