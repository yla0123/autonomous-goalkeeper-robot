<?xml version="1.0" ?>
<sdf version="1.9">

    <model name="soccer_ball">


        <link name="ball_link">
            <inertial>
                <mass>0.43</mass>

                <inertia>
                    <ixx>0.00208</ixx>
                    <iyy>0.00208</iyy>
                    <izz>0.00208</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>

            <collision name="ball_collision">
                <geometry>
                    <sphere>
                        <radius>0.11</radius>
                    </sphere>
                </geometry>
            </collision>

            <visual name="ball_vision">
                <geometry>
                    <sphere>
                        <radius>0.11</radius>
                    </sphere>
                </geometry>

                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
            </visual>
        </link>
    </model>

</sdf>